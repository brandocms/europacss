{
  // Everything you see is compiled from this config.
  theme: {
    breakpoints: { mobile: '0', tablet: '768px', desktop: '1200px' },
    breakpointCollections: { $sm: '<desktop', $lg: 'desktop' },
    colors: { ink: '#242139', accent: '#6657d9' },
    container: {
      padding: { mobile: '24px', tablet: '40px', desktop: '* 48px' },
      maxWidth: { mobile: '100%', tablet: '100%', desktop: '1280px' },
    },
    columns: { gutters: { mobile: '16px', tablet: '24px', desktop: '32px' } },
    spacing: {
      xs: { '*': '8px' },
      sm: { '*': '16px' },
      md: { mobile: '24px', tablet: '32px', desktop: '40px' },
      lg: { mobile: '40px', tablet: '64px', desktop: '80px' },
      section: { mobile: '64px', tablet: '96px', desktop: '128px' },
    },
    typography: {
      families: { sans: ['system-ui', 'sans-serif'] },
      sizes: {
        caption: { __base__: { 'line-height': 1.4 }, '*': '13px' },
        body: { __base__: { 'line-height': 1.6 }, mobile: '16px', tablet: '18px', desktop: '20px' },
        heading: {
          __base__: { 'font-weight': 600, 'line-height': 1.1, 'letter-spacing': '-0.035em' },
          mobile: '32px', tablet: '48px', desktop: '64px',
        },
        display: {
          __base__: { 'font-weight': 550, 'line-height': 1, 'letter-spacing': '-0.055em' },
          mobile: '48px', tablet: '72px', desktop: '96px',
        },
      },
    },
  },
}
