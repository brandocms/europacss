{
  enabled: true,
  theme: {
    breakpoints: { mobile: '0', tablet: '740px', desktop: '1024px' },
    breakpointCollections: { $sm: 'mobile/tablet', $lg: 'desktop' },
    colors: {
      ink: '#163442',
      text: '{colors.ink}', // Reuse another token without a callback.
      accent: '#fc7444',
    },
    spacing: {
      md: { mobile: '16px', tablet: '24px', desktop: '32px' },
    },
    typography: {
      families: { sans: ['Inter', 'sans-serif'] },
      sizes: {
        base: {
          __base__: {
            'font-family': '{typography.families.sans}',
            'line-height': '150%',
          },
          mobile: '16px',
          tablet: '18px',
          desktop: '20px',
        },

        // Shared properties, then breakpoint-specific overrides.
        'heading/4xl': {
          __base__: {
            'font-family': '{typography.families.sans}',
            'font-weight': 600,
            'line-height': 1.1,
            'letter-spacing': '-0.025em',
          },
          mobile: { 'font-size': '32px', 'line-height': 1.15 },
          tablet: { 'font-size': '48px' },
          desktop: {
            'font-size': 'clamp(48px, 4vw, 72px)',
            'letter-spacing': '-0.04em',
          },
        },
      },
    },
  },
}
